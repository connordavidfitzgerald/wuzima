# Resend API key. SECRET — never prefix with PUBLIC_. Get one at https://resend.com.
RESEND_API_KEY=re_your_api_key_here

# Where contact enquiries are delivered.
CONTACT_TO_EMAIL=info@wuzima.ca

# Verified Resend sender, e.g. "Wuzima <contact@wuzima.ca>".
CONTACT_FROM_EMAIL=Wuzima <onboarding@resend.dev>

# Sanity project. Public — the Studio at /admin reads both in the browser.
PUBLIC_SANITY_PROJECT_ID=n786oraf
PUBLIC_SANITY_DATASET=production

# Write token, only needed to run `pnpm seed`. Create one at
# https://www.sanity.io/manage/project/n786oraf/api with Editor rights.
# SANITY_WRITE_TOKEN=sk...
