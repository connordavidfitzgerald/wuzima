---
import RuleLink from "./RuleLink.astro";

const fields = [
    { name: "nom", label: "Nom*", type: "text", required: true },
    { name: "organisation", label: "Company/Organization", type: "text", required: false },
    { name: "email", label: "Email*", type: "email", required: true },
    { name: "tel", label: "Tel*", type: "tel", required: true },
];

const services = [
    "Culinary Experiences",
    "Culinary Services",
    "Programs & Social Impact",
    "Other / Not sure",
];

const columns = [
    {
        title: "Culinary Experiences",
        items: [
            "Private & Corporate Events",
            "Community Collaboration",
            "Cultural Experiences",
            "Culinary Workshops",
        ],
    },
    {
        title: "Culinary Services",
        items: ["Private & Corporate Catering", "Team Meeting Packages", "Craft Services"],
    },
    {
        title: "Programs & Social Impact",
        items: [
            "Youth and Family Programming",
            "Mentorship / Pre-professional training",
            "Culinary Education",
            "Community Partnerships",
        ],
    },
];
---

<section id="contact" class="bg-cream px-5 py-24 text-ink md:px-10 md:py-40">
    <div class="grid grid-cols-4 gap-x-5 md:grid-cols-12 md:gap-x-10">
        <h2
            class="col-span-4 text-[11px] leading-[1.03] tracking-[0.02em] text-ink/70 uppercase md:col-span-2 md:text-xs"
        >
            Contact
        </h2>

        <p
            class="col-span-4 mt-8 text-[clamp(1.375rem,2.4vw,2.25rem)] leading-[1.25] tracking-[-0.01em] md:col-span-9 md:col-start-4 md:mt-0"
        >
            Expérience gastronomique, activité de bien-être pour votre équipe, événement privé ou
            collaboration spéciale&nbsp;: racontez-nous ce que vous souhaitez créer.
        </p>
    </div>

    <div class="mt-20 grid grid-cols-4 gap-x-5 md:mt-[7.5rem] md:grid-cols-12 md:gap-x-10">
        <h3
            class="col-span-4 text-[11px] leading-[1.03] tracking-[0.02em] text-ink/70 uppercase md:col-span-2 md:text-xs"
        >
            Réserver un appel
        </h3>

        <form class="contact-form col-span-4 mt-10 md:col-span-4 md:col-start-4 md:mt-0">
            <div class="space-y-5">
                {
                    fields.map((field) => (
                        <div class="flex flex-col gap-10">
                            <label
                                for={field.name}
                                class="text-[11px] leading-[1.1] tracking-[0.02em] uppercase md:text-xs"
                            >
                                {field.label}
                            </label>
                            <input
                                id={field.name}
                                name={field.name}
                                type={field.type}
                                required={field.required}
                                class="-mt-8 border-b border-ink/60 bg-transparent pb-2 text-[13px] outline-none focus:border-ink md:text-sm"
                            />
                        </div>
                    ))
                }
            </div>

            <fieldset class="mt-10">
                <legend class="text-[11px] leading-[1.1] tracking-[-0.01em] uppercase md:text-xs">
                    Service:
                </legend>
                <div class="mt-4 flex flex-col gap-[5px]">
                    {
                        services.map((service) => (
                            <label class="group flex cursor-pointer items-center gap-1.5 text-[11px] leading-[1.1] tracking-[-0.01em] md:text-xs">
                                <input
                                    type="checkbox"
                                    name="service"
                                    value={service}
                                    class="peer sr-only"
                                />
                                <span class="peer-checked:hidden">[ ]</span>
                                <span class="hidden peer-checked:inline">[×]</span>
                                <span class="group-hover:opacity-60">{service}</span>
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            {/* Web3Forms honeypot — bots fill it in, humans never see it. */}
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

            <div class="mt-10 flex flex-wrap items-baseline gap-x-6 gap-y-3">
                <RuleLink
                    type="submit"
                    class="contact-form__submit text-[11px] leading-[1.1] md:text-xs"
                >
                    [ Submit → ]
                </RuleLink>
                <p
                    class="contact-form__status hidden max-w-[34ch] text-[11px] leading-[1.2] text-ink/70 md:text-xs"
                    role="status"
                    aria-live="polite"
                >
                </p>
            </div>
        </form>
    </div>

    <div class="mt-24 grid grid-cols-4 gap-x-5 gap-y-8 md:mt-[7.5rem] md:grid-cols-12 md:gap-x-10">
        <h3
            class="col-span-4 text-[11px] leading-[1.03] tracking-[0.02em] text-ink/70 uppercase md:col-span-2 md:text-xs"
        >
            Services
        </h3>

        {
            columns.map((column, index) => (
                <div
                    class:list={[
                        "col-span-4 text-[11px] leading-[1.2] md:col-span-3 md:text-xs",
                        ["md:col-start-4", "md:col-start-7", "md:col-start-10"][index],
                    ]}
                >
                    <p class="opacity-70">{column.title}</p>
                    <ul>
                        {column.items.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>
</section>

<script>
    import gsap from "gsap";

    const ENDPOINT = "/api/contact";

    const MESSAGES = {
        sending: "Envoi en cours…",
        success: "Merci — notre équipe vous répondra dans les 24 heures.",
        error: "Une erreur est survenue. Merci de réessayer ou de nous écrire à info@wuzima.ca.",
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((form) => {
        const status = form.querySelector<HTMLElement>(".contact-form__status");
        const submit = form.querySelector<HTMLButtonElement>(".contact-form__submit");
        if (!status || !submit) return;

        const show = (message: string, tone: "pending" | "success" | "error") => {
            status.textContent = message;
            status.classList.remove("hidden");
            status.classList.toggle("text-ink/70", tone !== "error");
            status.classList.toggle("text-ink", tone === "error");

            gsap.killTweensOf(status);
            gsap.fromTo(
                status,
                { opacity: 0, y: 4 },
                { opacity: 1, y: 0, duration: reduceMotion.matches ? 0 : 0.5, ease: "power3.out" },
            );
        };

        const hide = () => {
            if (status.classList.contains("hidden")) return;
            gsap.killTweensOf(status);
            status.classList.add("hidden");
        };

        form.addEventListener("submit", async (event) => {
            // The submit event only fires once native validation passes, so the
            // required fields are still enforced before anything is sent.
            event.preventDefault();

            submit.disabled = true;
            show(MESSAGES.sending, "pending");

            try {
                const response = await fetch(ENDPOINT, {
                    method: "POST",
                    body: new FormData(form),
                });

                if (!response.ok) throw new Error(`Endpoint responded ${response.status}`);

                form.reset();
                show(MESSAGES.success, "success");
            } catch (error) {
                console.error("Contact form submission failed:", error);
                show(MESSAGES.error, "error");
            } finally {
                submit.disabled = false;
            }
        });

        // Once they start filling it in again, the last result is stale.
        form.addEventListener("input", hide);
    });
</script>
