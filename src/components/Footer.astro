---
import Mark from "./Mark.astro";
import RuleLink from "./RuleLink.astro";
---

<footer class="fixed inset-x-0 bottom-0 z-0 h-footer bg-olive px-5 py-5 text-cream">
  <Mark class="h-[4.25rem] w-12 text-cream" />

  <div class="mt-10 flex items-center justify-between text-[11px] leading-[1.1] tracking-[0.02em] uppercase md:text-xs">
    <RuleLink href="mailto:info@wuzima.ca">info@wuzima.ca</RuleLink>
    <RuleLink
      href="https://instagram.com/wuzima_inc"
      target="_blank"
      rel="noreferrer"
    >
      @wuzima_inc
    </RuleLink>
  </div>
</footer>
