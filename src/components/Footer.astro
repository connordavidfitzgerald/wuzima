---
import Mark from "./Mark.astro";
import RuleLink from "./RuleLink.astro";
import { getLangFromUrl } from "../i18n";
import { getContent, text } from "../lib/content";

const { settings } = await getContent(getLangFromUrl(Astro.url));

const email = text(settings?.email);
---

<footer
    class="fixed inset-x-0 bottom-0 z-0 h-footer bg-olive px-gutter py-gutter text-cream flex flex-col justify-between"
>
    <Mark class="h-[4.25rem] w-12 text-cream" />

    <div
        class="flex items-center justify-between leading-[1.1] tracking-[0.02em] uppercase text-label"
    >
        <RuleLink href={`mailto:${email}`}>{email}</RuleLink>
        {
            settings?.instagramUrl && (
                <RuleLink href={settings.instagramUrl} target="_blank" rel="noreferrer">
                    {text(settings.instagramHandle)}
                </RuleLink>
            )
        }
    </div>
</footer>
