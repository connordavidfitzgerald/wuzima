---
/* Image inside a fixed-ratio window that drifts a little slower than the page.
   The wrapper crops; the image is scaled just enough to cover the drift, so no
   edge is ever exposed at either end of the scroll.

   The photograph comes from Sanity, so the sources are asked for from its CDN
   rather than built by `astro:assets`. The alt text travels with the image —
   it is a field on the photograph in the Studio, not a prop the page invents —
   and the blurred placeholder Sanity generates sits behind the frame so the
   window is never a bare rectangle while the file arrives. */
import type { Figure } from "../lib/image";
import { srcSet, urlFor } from "../lib/image";

interface Props {
    image: Figure | null | undefined;
    /* Layout classes for the window — grid placement, width, aspect ratio. */
    class?: string;
    /* Drift in percent of the window height, applied in both directions. */
    amount?: number;
    /* The widths to offer, and the width the window actually renders at, so a
       frame inside a responsive grid can ask for a source that fits it. */
    widths?: number[];
    sizes?: string;
    loading?: "lazy" | "eager";
}

const {
    image,
    class: className = "",
    amount = 6,
    widths = [712, 1424],
    sizes,
    loading = "lazy",
} = Astro.props;

const dimensions = image?.asset?.metadata?.dimensions;
const placeholder = image?.asset?.metadata?.lqip;
---

{
    image?.asset && (
        <div
            class={`parallax overflow-hidden ${className}`}
            data-parallax={amount}
            style={placeholder
                ? `background-image:url(${placeholder});background-size:cover;background-position:center`
                : undefined}
        >
            <img
                src={urlFor(image).width(widths[widths.length - 1]!).url()}
                srcset={srcSet(image, widths)}
                sizes={sizes}
                width={dimensions?.width}
                height={dimensions?.height}
                alt={image.alt ?? ""}
                loading={loading}
                decoding="async"
                class="parallax__img h-[110%] w-[110%] object-cover"
            />
        </div>
    )
}

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    /* One matchMedia context per page. A view transition replaces the frames
       under it, so the outgoing context is reverted on the way out rather than
       left holding triggers pointed at elements the document no longer has. */
    let media: gsap.MatchMedia | undefined;

    function bindParallax() {
        media = gsap.matchMedia();

        media.add("(prefers-reduced-motion: no-preference)", () => {
            document.querySelectorAll<HTMLElement>(".parallax").forEach((frame) => {
                const image = frame.querySelector<HTMLElement>(".parallax__img");
                if (!image) return;

                const amount = Number(frame.dataset.parallax) || 20;

                /* Travelling `amount`% in each direction uncovers `amount`% of
                   the window at top and bottom, which a scale of 1 + 2×amount
                   fills. */
                gsap.set(image, { scale: 1 + (amount * 2) / 100, willChange: "transform" });

                gsap.fromTo(
                    image,
                    { yPercent: -amount },
                    {
                        yPercent: amount,
                        ease: "none",
                        scrollTrigger: {
                            trigger: frame,
                            start: "top bottom",
                            end: "bottom top",
                            scrub: true,
                        },
                    },
                );
            });

            return () => gsap.set(".parallax__img", { clearProps: "transform,willChange" });
        });
    }

    document.addEventListener("astro:page-load", bindParallax);

    document.addEventListener("astro:before-swap", () => {
        media?.revert();
        media = undefined;
    });
</script>
